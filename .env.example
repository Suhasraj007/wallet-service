# Copy to .env for local runs, or set these in your hosting provider's dashboard.
# Nothing in this file is a real secret.

# Postgres (Neon / Supabase / compose). JDBC form, not postgres://
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/wallet
SPRING_DATASOURCE_USERNAME=wallet
SPRING_DATASOURCE_PASSWORD=wallet

# At least 32 bytes. Generate one: openssl rand -base64 48
JWT_SECRET=change-me-to-a-real-secret-of-32-plus-bytes

# Demo funding for brand-new wallets (paise). See WRITEUP.md.
INITIAL_BALANCE_PAISE=100000

TOKEN_TTL_SECONDS=86400

# Connection pool and timeouts. Defaults are sized for a small free-tier
# instance; raise the pool if you run a bigger box.
DB_POOL_SIZE=20
DB_CONNECTION_TIMEOUT_MS=10000
DB_SOCKET_TIMEOUT_SECONDS=30

# json -> one JSON log object per line (use in deployed environments)
SPRING_PROFILES_ACTIVE=json

# --- Grafana Cloud Loki (only needed when the "loki" profile is active) ---
# Push URL looks like: https://logs-prod-XXX.grafana.net/loki/api/v1/push
LOKI_URL=
# Numeric Loki user id from your Grafana Cloud stack
LOKI_USERNAME=
# A Grafana Cloud access-policy token with logs:write scope
LOKI_PASSWORD=
LOKI_ENV=prod
